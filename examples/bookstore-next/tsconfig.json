{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "esnext"], "jsx": "preserve", "module": "esnext", "moduleResolution": "bundler",
    "strict": false, "skipLibCheck": true, "noEmit": true, "allowJs": true, "baseUrl": ".", "paths": { "@/*": ["./*"] }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}

graft cg_code_graph
prune cg_code_graph/plugins/ts/extractor/node_modules
prune cg_code_graph/plugins/php/extractor/vendor
prune cg_code_graph/plugins/dart/extractor/.bin
prune cg_code_graph/plugins/dart/extractor/.dart_tool
prune cg_code_graph/viz/tools/node_modules
prune cg_code_graph/viz/tools/screenshots
global-exclude __pycache__ *.py[cod] *.db *.db-wal *.db-shm
